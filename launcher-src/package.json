{
  "name": "rift-client",
  "productName": "Rift Launcher",
  "version": "1.0.0",
  "description": "Rift Launcher - Minecraft Launcher mit Modrinth, Shop und Crates",
  "main": "loader.js",
  "author": "Rift",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage",
    "postinstall": "node scripts/vendor.js",
    "predist": "node scripts/vendor.js",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "skinview3d": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "net.rift.client",
    "productName": "Rift Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "loader.js",
      "main.js",
      "preload.js",
      "admin.js",
      "servers.js",
      "stats.js",
      "localserver.js",
      "config.json",
      "renderer/**/*",
      "build/**/*",
      "node_modules/**/*",
      "!node_modules/skinview3d/**/*.map",
      "overlay.js",
      "aicheck.js",
      "mod/*.jar"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RiftLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "RiftLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "afterPack": "scripts/afterPack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null
    },
    "dmg": {
      "artifactName": "RiftLauncher-${version}-${arch}.${ext}"
    }
  }
}